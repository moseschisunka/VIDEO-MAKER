{
  "name": "talking_head_basic",
  "pipeline_type": "talking-head",
  "description": "Source-footage talking-head clip with verified transcript, captions, and a vertical social delivery.",
  "inputs": {
    "source_mode": "user_footage",
    "brief": "Edit supplied talking-head footage into a concise vertical social lesson.",
    "profile": "social_vertical",
    "duration_seconds": 15,
    "input_media": ["fixtures/media/talking_head_intro.mp4"],
    "target_platform": "youtube_shorts"
  },
  "expected_artifacts": {
    "brief": {
      "required_fields": ["title", "hook", "key_points", "tone", "style", "target_platform", "target_duration_seconds"]
    },
    "script": {
      "required_fields": ["title", "total_duration_seconds", "sections"],
      "assertions": { "sections_not_empty": true, "total_duration_range": [10, 20] }
    },
    "scene_plan": {
      "required_fields": ["scenes"],
      "assertions": { "scenes_not_empty": true, "all_scenes_are_talking_head": true }
    },
    "asset_manifest": {
      "required_fields": ["assets"],
      "assertions": { "has_subtitle_asset": true, "has_source_footage_asset": true }
    },
    "edit_decisions": {
      "required_fields": ["cuts", "render_runtime"],
      "assertions": { "subtitles_enabled": true, "cuts_cover_full_duration": true }
    },
    "render_report": {
      "required_fields": ["outputs"],
      "assertions": { "output_file_exists": true, "output_is_playable": true, "resolution_matches_profile": true }
    },
    "publish_log": {
      "required_fields": ["entries"],
      "assertions": { "has_at_least_one_entry": true }
    }
  },
  "eval_mode": "stochastic",
  "tolerance": 0.5,
  "profile": "social_vertical",
  "duration_seconds": 15,
  "duration_tolerance_seconds": 1.0,
  "voice_intent": {
    "mode": "original_source_audio",
    "provider_policy": "preserve_selected_voice_and_do_not_synthesize_without_approval",
    "transcript_policy": "timestamps_must_match_source_speech"
  },
  "visual_strategy": {
    "mode": "source_footage_with_captions",
    "description": "Use the supplied speaker footage as the visual anchor with purposeful crops and readable captions.",
    "asset_sources": ["user_media", "subtitle_generator"],
    "motion_requirement": "preferred"
  },
  "runtime_candidates": ["remotion", "ffmpeg"],
  "expected_approvals": ["idea", "script", "scene_plan", "assets", "edit", "publish"],
  "prohibited_downgrade": [
    "replace supplied speaker footage with stock or generated media without approval",
    "claim captions are accurate without transcript timestamp verification"
  ],
  "tags": ["phase0", "source-footage", "talking-head", "vertical", "captions"]
}
