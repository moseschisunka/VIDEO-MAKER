{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/artifacts/final_review",
  "title": "Final Review",
  "description": "Structured self-review of the rendered output. The compose stage must produce this artifact to prove the agent inspected the actual rendered video before presenting it to the user. If status is 'revise' or 'fail', the agent must not present the video as complete.",
  "type": "object",
  "required": ["version", "output_path", "status", "checks"],
  "properties": {
    "version": { "type": "string", "const": "1.0" },
    "output_path": {
      "type": "string",
      "description": "Path to the rendered output file that was reviewed"
    },
    "project_id": { "type": "string", "minLength": 1 },
    "pipeline_type": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[4][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "attempt": { "type": "integer", "minimum": 1 },
    "output_profile": { "type": "string", "minLength": 1 },
    "profile": { "type": "string", "minLength": 1 },
    "voice_identity": {
      "type": "object",
      "description": "Approved narration voice identity carried into the final review.",
      "required": ["provider", "model", "voice_id", "locale", "identity_key"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "voice_id": { "type": "string", "minLength": 1 },
        "locale": { "type": "string", "minLength": 1 },
        "settings": { "type": "object", "additionalProperties": true },
        "identity_key": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "status": {
      "type": "string",
      "enum": ["pass", "revise", "fail"],
      "description": "pass=ready to present, revise=fixable issues found, fail=critical problems"
    },
    "checks": {
      "type": "object",
      "required": [
        "technical_probe",
        "visual_spotcheck",
        "audio_spotcheck",
        "promise_preservation",
        "subtitle_check"
      ],
      "properties": {
        "technical_probe": {
          "type": "object",
          "description": "ffprobe validation of the output file",
          "properties": {
            "valid_container": { "type": "boolean" },
            "duration_seconds": { "type": "number" },
            "resolution": { "type": "string" },
            "fps": { "type": "number" },
            "has_audio": { "type": "boolean" },
            "codec": { "type": "string" },
            "file_size_bytes": { "type": "integer" },
            "stream_count": { "type": "integer", "minimum": 0 },
            "audio_channels": { "type": "integer", "minimum": 0 },
            "audio_channel_layout": { "type": ["string", "null"] },
            "audio_tags": { "type": "object", "additionalProperties": true },
            "issues": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "visual_spotcheck": {
          "type": "object",
          "description": "Sample frames inspected from opening, middle, climax, ending",
          "properties": {
            "frames_sampled": { "type": "integer", "minimum": 4 },
            "frame_paths": {
              "type": "array",
              "items": { "type": "string" }
            },
            "black_frames_detected": { "type": "boolean" },
            "broken_overlays": { "type": "boolean" },
            "missing_assets": { "type": "boolean" },
            "unreadable_text": { "type": "boolean" },
            "issues": {
              "type": "array",
              "items": { "type": "string" }
            },
            "video_quality": { "type": "object" },
            "visual_contract": {
              "type": "object",
              "properties": {
                "valid": { "type": "boolean" },
                "overlay_bounds_checked": { "type": "integer", "minimum": 0 },
                "missing_sources": { "type": "array", "items": { "type": "string" } },
                "placeholder_tokens": { "type": "array", "items": { "type": "object" } },
                "errors": { "type": "array", "items": { "type": "string" } },
                "warnings": { "type": "array", "items": { "type": "string" } }
              },
              "additionalProperties": false
            }
          }
        },
        "audio_spotcheck": {
          "type": "object",
          "description": "Audio quality verification",
          "properties": {
            "narration_present": { "type": "boolean" },
            "music_present": { "type": "boolean" },
            "unexpected_silence": { "type": "boolean" },
            "clipping_detected": { "type": "boolean" },
            "mix_intelligible": { "type": "boolean" },
            "issues": {
              "type": "array",
              "items": { "type": "string" }
            },
            "language_expected": { "type": ["string", "null"] },
            "language_observed": { "type": ["string", "null"] },
            "language_match": { "type": ["boolean", "null"] },
            "audio_quality": { "type": ["object", "null"] }
          }
        },
        "visual_timeline": {
          "type": "object",
          "description": "Editorial visual-beat cadence and primary-track coverage validation.",
          "properties": {
            "valid": { "type": "boolean" },
            "enforced": { "type": "boolean" },
            "duration_seconds": { "type": "number" },
            "beat_seconds": { "type": "number" },
            "cut_count": { "type": "integer", "minimum": 0 },
            "minimum_beats": { "type": "integer", "minimum": 0 },
            "transition_boundaries_declared": { "type": "integer", "minimum": 0 },
            "coverage_start_seconds": { "type": ["number", "null"] },
            "coverage_end_seconds": { "type": "number" },
            "errors": { "type": "array", "items": { "type": "string" } },
            "warnings": { "type": "array", "items": { "type": "string" } },
            "note": { "type": "string" }
          },
          "additionalProperties": false
        },
        "narration_timeline": {
          "type": "object",
          "description": "Optional narration segment timing and coverage validation.",
          "properties": {
            "valid": { "type": "boolean" },
            "enforced": { "type": "boolean" },
            "segment_count": { "type": "integer", "minimum": 0 },
            "coverage_verified": { "type": "boolean" },
            "errors": { "type": "array", "items": { "type": "string" } },
            "warnings": { "type": "array", "items": { "type": "string" } },
            "note": { "type": "string" }
          },
          "additionalProperties": false
        },
        "promise_preservation": {
          "type": "object",
          "description": "Delivery promise and renderer governance checks",
          "properties": {
            "delivery_promise_honored": { "type": "boolean" },
            "renderer_family_used": { "type": "string", "description": "Creative grammar that actually ran" },
            "render_runtime_used": {
              "type": "string",
              "enum": ["remotion", "hyperframes", "ffmpeg"],
              "description": "Technical runtime that actually executed the render. Must match the runtime locked at proposal unless a logged decision overrode it."
            },
            "runtime_swap_detected": {
              "type": "boolean",
              "description": "True if the runtime that ran differs from the runtime locked in proposal_packet. An unapproved swap is a contract violation."
            },
            "runtime_swap_check": {
              "type": "string",
              "description": "Human-readable status of the runtime-swap check: 'ok — …', 'detected — …', or 'skipped — …'. When the check was skipped, the reviewer skill is responsible for cross-artifact comparison."
            },
            "motion_ratio_actual": { "type": "number" },
            "silent_downgrade_detected": { "type": "boolean" },
            "issues": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "subtitle_check": {
          "type": "object",
          "description": "Subtitle/caption verification against source script",
          "properties": {
            "subtitles_expected": { "type": "boolean" },
            "subtitles_present": { "type": "boolean" },
            "coverage_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
            "timing_drift_detected": { "type": "boolean" },
            "issues": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "transcript_comparison": {
          "type": "object",
          "description": "Optional: transcribe the output and compare to source script",
          "properties": {
            "transcript_matches_script": { "type": ["boolean", "null"] },
            "word_accuracy": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
            "language_expected": { "type": ["string", "null"] },
            "language_observed": { "type": ["string", "null"] },
            "language_match": { "type": ["boolean", "null"] },
            "voice_identity_observed": { "type": ["object", "null"] },
            "voice_identity_match": { "type": ["boolean", "null"] },
            "issues": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "cross_artifact": {
          "type": "object",
          "description": "Deterministic identity/profile/render linkage checks.",
          "properties": {
            "valid": { "type": "boolean" },
            "checked": { "type": "boolean" },
            "errors": { "type": "array", "items": { "type": "string" } },
            "warnings": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": false
        },
        "voice_over": {
          "type": "object",
          "description": "Immutable voice identity and language evidence checks.",
          "properties": {
            "identity_expected": { "type": ["object", "null"] },
            "identity_observed": { "type": ["object", "null"] },
            "identity_match": { "type": ["boolean", "null"] },
            "language_expected": { "type": ["string", "null"] },
            "language_observed": { "type": ["string", "null"] },
            "language_match": { "type": ["boolean", "null"] },
            "identity_evidence": { "type": "array", "items": { "type": "object" } },
            "issues": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": false
        },
        "atelier": {
          "type": "object",
          "description": "Atelier-only doctrine checks (populated when composition_mode='atelier'). Generated by tools/video/video_compose.py → _run_atelier_checks.",
          "properties": {
            "stock_reuse_detected": { "type": "boolean", "description": "TRUE if the bespoke project imports from the stock creative registry — fails the render." },
            "offending_imports": {
              "type": "array",
              "description": "Files + import paths that violated the doctrine.",
              "items": {
                "type": "object",
                "properties": {
                  "file": { "type": "string" },
                  "import": { "type": "string" }
                }
              }
            },
            "art_direction_declared": { "type": "boolean" },
            "art_direction": { "type": ["string", "null"] },
            "issues": { "type": "array", "items": { "type": "string" } }
          }
        }
      },
          "additionalProperties": false
        },
        "voice_over": {
          "type": "object",
          "description": "Voice identity, approval, segment resume, and transcript evidence.",
          "properties": {
            "identity_key": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "provider": { "type": "string" },
            "model": { "type": "string" },
            "voice_id": { "type": "string" },
            "locale": { "type": "string" },
            "sample_approved": { "type": "boolean" },
            "segment_count": { "type": "integer", "minimum": 0 },
            "completed_segments": { "type": "integer", "minimum": 0 },
            "cache_hits": { "type": "integer", "minimum": 0 },
            "transcript_matches_script": { "type": ["boolean", "null"] },
            "word_accuracy": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
            "pronunciation_notes": { "type": "array", "items": { "type": "string" } },
            "issues": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": false
        },
    "issues_found": {
      "type": "array",
      "items": { "type": "string" },
      "description": "All issues found across all checks, summarized for the user"
    },
    "review_id": { "type": "string", "minLength": 1 },
    "output_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "reviewed_at": { "type": "string", "format": "date-time" },
    "recommended_action": {
      "type": "string",
      "enum": ["present_to_user", "re_render", "revise_edit", "revise_assets", "block", "re_author"],
      "description": "What the agent should do next based on the review findings"
    },
    "metadata": { "type": "object" }
  },
  "additionalProperties": false
}
