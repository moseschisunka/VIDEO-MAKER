{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/media/diagram_request",
  "title": "Structured Diagram Request",
  "type": "object",
  "required": ["diagram_type"],
  "properties": {
    "diagram_type": { "type": "string", "enum": ["mermaid", "flowchart", "boxes"] },
    "definition": { "type": "string" },
    "boxes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["label"],
        "properties": { "label": { "type": "string", "minLength": 1 }, "color": { "type": "string" } },
        "additionalProperties": false
      }
    },
    "connections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to"],
        "properties": { "from": { "type": "integer", "minimum": 0 }, "to": { "type": "integer", "minimum": 0 }, "label": { "type": "string" } },
        "additionalProperties": false
      }
    },
    "title": { "type": "string" },
    "theme": { "type": "string", "enum": ["dark", "light", "neutral"] },
    "width": { "type": "integer", "minimum": 320 },
    "height": { "type": "integer", "minimum": 180 },
    "output_path": { "type": "string" }
  },
  "additionalProperties": false
}
