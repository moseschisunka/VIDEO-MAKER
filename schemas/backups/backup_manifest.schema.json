{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/backups/backup_manifest",
  "title": "OpenMontage Project Backup Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "backup_id", "created_at", "project_id", "include_media", "source_layout", "files", "excluded"],
  "properties": {
    "version": { "type": "string", "const": "1.0" },
    "backup_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "created_at": { "type": "string", "format": "date-time" },
    "project_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "include_media": { "type": "boolean" },
    "source_layout": { "type": "string", "const": "openmontage-project-root" },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "size_bytes", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "size_bytes": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "excluded": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
